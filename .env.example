# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" itself is gitignored - never commit real credentials.

# The Gmail address the reminder emails will be sent FROM
EMAIL_ADDRESS=youraddress@gmail.com

# NOT your normal Gmail password. This must be a 16-character "App Password":
# 1. Turn on 2-Step Verification on the Google account first (required):
#    https://myaccount.google.com/security
# 2. Then generate an app password here: https://myaccount.google.com/apppasswords
# 3. Paste the 16 characters below with no spaces.
EMAIL_APP_PASSWORD=your16characterapppassword